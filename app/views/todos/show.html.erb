<p style="color: green"><%= notice %></p>

<%= render @todo %>

<div>
  <%= link_to "Edit this todo", edit_todo_path(@todo) %> |
  <%= link_to "Back to todos", todos_path %>
  <p>
    <strong>Done:</strong>
    <%= @todo.done ? "Yes" : "No" %>
  </p>

  <%= button_to "Destroy this todo", @todo, method: :delete %>
</div>
